# ---- 上游 ----
HF_GATEWAY=https://fnf-api-gw.higgsfield.ai/fnf
HF_CLERK_PROXY=https://higgsfield.ai/_clerk
HF_IMPERSONATE=chrome
HF_EXTRA_HEADERS={"hf-surface":"web"}

# ---- 凭据（二选一：只写路径 / 直接给单行 JSON） ----
HF_COOKIES_FILE=./secrets/cookies.json
# HF_COOKIES_JSON={"__client":"...","__client_uat":"..."}

# ---- 计费红线：默认关。开之前先跑 POST /admin/dry-run ----
ALLOW_BILLING=0
USE_FREE_GENS=1
MAX_DURATION=5
MAX_BATCH=1

# ---- 服务 ----
# 空 = 不鉴权（只能绑回环）。对外发布必须设置，生成方式：openssl rand -hex 16
SERVICE_TOKEN=

TASK_DB=./data/tasks.db
EXECUTION_EXPIRES_AFTER=172800
POLL_INTERVAL=5
