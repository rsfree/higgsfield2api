# ---- 上游 ----
HF_GATEWAY=https://fnf-api-gw.higgsfield.ai/fnf
HF_CLERK_PROXY=https://higgsfield.ai/_clerk
HF_IMPERSONATE=chrome
HF_EXTRA_HEADERS={"hf-surface":"web"}

# ---- 号池 ----
# 账号存在 data/accounts.json（0600，含 cookie 明文）。推荐在面板 /panel 里导入。
ACCOUNTS_FILE=./data/accounts.json
# 兼容单账号模式的兜底：号池为空时会自动收编下面这份配置，建成 acc-default
HF_COOKIES_FILE=./secrets/cookies.json
# HF_COOKIES_JSON={"__client":"...","__client_uat":"..."}

# 选号与熔断（一般不用改）
# POOL_RETRY        建任务最多试几个号；只对 401/429/CF 403 生效
# POOL_AUTH_STRIKES 连续几次 401 判死（单次 401 只冷却）
# POOL_RATE_COOLDOWN 429 冷却秒；POOL_BASE_COOLDOWN 其它失败退避基数
POOL_RETRY=2
POOL_AUTH_STRIKES=2
POOL_AUTH_COOLDOWN=120
POOL_RATE_COOLDOWN=90
POOL_BASE_COOLDOWN=30
POOL_MAX_COOLDOWN=600
# 单号自检超时秒。连不通的号不该让整批导入卡住几十秒
PROBE_TIMEOUT=12

# ---- 计费红线：默认关。开之前先跑 POST /admin/dry-run ----
ALLOW_BILLING=0
USE_FREE_GENS=1
MAX_DURATION=5
MAX_BATCH=1

# ---- 服务 ----
# API 鉴权 + 面板登录口令。空 = 不鉴权（只能绑回环）。对外发布必须设置。
#   openssl rand -hex 16   → 生成随机值
SERVICE_TOKEN=sk-xxxxxxxxxxxxxxxx
# 面板单独口令；留空则复用 SERVICE_TOKEN（一个口令管 API + 面板）
PANEL_PASSWORD=

TASK_DB=./data/tasks.db
EXECUTION_EXPIRES_AFTER=172800
POLL_INTERVAL=5
